#!/bin/bash

# Файл с прокси данными
PROXY_FILE="$HOME/.vpn_proxy"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)" || SCRIPT_DIR="/usr/local/bin"
VLESS_SCRIPT="$SCRIPT_DIR/vless_to_xray.sh"
LOCAL_HTTP_PORT=1081

# Проверяем наличие файла с прокси
if [ ! -f "$PROXY_FILE" ]; then
    echo "Error: Proxy file $PROXY_FILE not found!"
    echo "Create it with one of these formats:"
    echo "  HTTP Proxy: IP:PORT:USER:PASS"
    echo "  VLESS: vless://UUID@HOST:PORT?params#name"
    echo ""
    echo "Examples:"
    echo "  168.80.200.220:8000:username:password"
    echo "  vless://uuid@host:443?security=reality&sni=example.com#name"
    exit 1
fi

# Читаем прокси из файла
PROXY_DATA=$(cat "$PROXY_FILE" | head -n 1)

# Проверяем что данные не пустые
if [ -z "$PROXY_DATA" ]; then
    echo "Error: Proxy file is empty!"
    exit 1
fi

# Определяем тип прокси (VLESS или HTTP)
if [[ "$PROXY_DATA" =~ ^vless:// ]]; then
    # Это VLESS URL - нужен xray
    if [ ! -f "$VLESS_SCRIPT" ]; then
        echo "Error: VLESS support script not found at $VLESS_SCRIPT"
        exit 1
    fi

    # Проверяем и запускаем xray если нужно
    source "$VLESS_SCRIPT"

    # Проверяем запущен ли xray
    XRAY_PID_FILE="/tmp/xray_vpn.pid"
    if [ ! -f "$XRAY_PID_FILE" ] || ! kill -0 $(cat "$XRAY_PID_FILE" 2>/dev/null) 2>/dev/null; then
        echo "Starting xray with VLESS configuration..."
        generate_xray_config "$PROXY_DATA" > /dev/null
        start_xray > /dev/null

        if [ $? -ne 0 ]; then
            echo "Error: Failed to start xray"
            echo "Check if xray is installed: https://github.com/XTLS/Xray-core"
            exit 1
        fi
    fi

    # Используем локальный HTTP прокси от xray
    PROXY_URL="http://127.0.0.1:${LOCAL_HTTP_PORT}"

else
    # Это HTTP прокси в формате IP:PORT:USER:PASS
    # Парсим данные прокси
    IFS=':' read -r PROXY_IP PROXY_PORT PROXY_USER PROXY_PASS <<< "$PROXY_DATA"

    # Проверяем что все поля заполнены
    if [ -z "$PROXY_IP" ] || [ -z "$PROXY_PORT" ]; then
        echo "Error: Invalid proxy format in $PROXY_FILE"
        echo "Expected format: IP:PORT:USER:PASS or vless://..."
        exit 1
    fi

    # Формируем URL прокси с авторизацией или без
    if [ -n "$PROXY_USER" ] && [ -n "$PROXY_PASS" ]; then
        PROXY_URL="http://${PROXY_USER}:${PROXY_PASS}@${PROXY_IP}:${PROXY_PORT}"
    else
        PROXY_URL="http://${PROXY_IP}:${PROXY_PORT}"
    fi
fi

# Устанавливаем переменные окружения для прокси и запускаем команду
export http_proxy="$PROXY_URL"
export https_proxy="$PROXY_URL"
export HTTP_PROXY="$PROXY_URL"
export HTTPS_PROXY="$PROXY_URL"

# Запускаем команду
exec "$@"
